-- Delta Tower/Plant Auto-Farm Script (Authorized Users & Fallback Pet ID)
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Check if the executor is authorized
if LocalPlayer.Name ~= "Zackalar" and LocalPlayer.Name ~= "togoshi00" then
    warn("Unauthorized user! This script can only be executed by Zackalar or togoshi00.")
    return
end

local CoreGui = game:GetService("CoreGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")

-- Clean up existing GUI if already running
if CoreGui:FindFirstChild("TowerFarmGUI") then
    CoreGui.TowerFarmGUI:Destroy()
end

-- Create Minimal GUI Elements (Status & Rejoin Only)
local ScreenGui = Instance.new("ScreenGui")
