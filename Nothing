MainShadow.Transparency = 1
MainShadow.Parent = MainFrame

task.spawn(function()
    local infoIn = TweenInfo.new(0.7, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    TweenService:Create(IntroCircle, infoIn, {Size = UDim2.new(0, 90, 0, 90)}):Play()
    TweenService:Create(IntroCircleStroke, TweenInfo.new(0.5), {Transparency = 0}):Play()
    TweenService:Create(IntroLabel, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {TextSize = 42, TextTransparency = 0}):Play()
    
    task.wait(0.2)
    TweenService:Create(SubText, TweenInfo.new(0.4), {TextTransparency = 0.2}):Play()
    
    task.wait(1.2)
    
    local maxDiagonal = math.max(workspace.CurrentCamera.ViewportSize.X, workspace.CurrentCamera.ViewportSize.Y) * 2.5
    local expandTween = TweenService:Create(WhiteTransition, TweenInfo.new(0.5, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, maxDiagonal, 0, maxDiagonal)
    })
    expandTween:Play()
    
    expandTween.Completed:Connect(function()
        IntroBWEffect:Destroy()
        IntroGui:Destroy()
        
        MainFrame.Visible = true
        
        local fadeInInfo = TweenInfo.new(0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
        TweenService:Create(MainFrame, fadeInInfo, {BackgroundTransparency = 0}):Play()
        TweenService:Create(MainShadow, fadeInInfo, {Transparency = 0}):Play()
        
        task.delay(0.4, function()
            WhiteTransition:Destroy()
        end)
    end)
end)

