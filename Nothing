local function createTabButton(name, text, positionY)
    local btn = Instance.new("TextButton")
    btn.Parent = Sidebar
    btn.BackgroundColor3 = (name == "Main") and themes.Dark.TabActive or themes.Dark.TabInactive
    btn.Position = UDim2.new(0, 6, 0, positionY)
    btn.Size = UDim2.new(1, -12, 0, 22)
    btn.Font = Enum.Font.GothamBold
    btn.Text = text
    btn.TextColor3 = (name == "Main") and themes.Dark.TabTextActive or themes.Dark.TabTextInactive
    btn.TextSize = 8
    btn.AutoButtonColor = false
    
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
    
    btn.MouseButton1Click:Connect(function()
        for tName, pageObj in pairs(Pages) do
            pageObj.Visible = (tName == name)
            local t = themes[currentTheme]
            tabButtons[tName].BackgroundColor3 = t.TabInactive
            tabButtons[tName].TextColor3 = t.TabTextInactive
        end
        local t = themes[currentTheme]
        btn.BackgroundColor3 = t.TabActive
        btn.TextColor3 = t.TabTextActive
    end)
    
    tabButtons[name] = btn
    themeRegistry.TabButtons[name] = btn
end

