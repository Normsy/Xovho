local giftOptionButtons = {}
local function updateItemButtonText()
    local count = 0
    local firstName = ""
    for _, itemName in ipairs(validItems) do
        if selectedItemsMap[itemName] then
            count = count + 1
            if firstName == "" then firstName = itemName end
        end
    end
    if count == 0 then ItemSelectBtn.Text = "Select Items ▼"
    elseif count == #validItems then ItemSelectBtn.Text = "All Selected ▼"
    elseif count == 1 then ItemSelectBtn.Text = firstName
    else ItemSelectBtn.Text = "Selected (" .. count .. ") ▼" end
end

local function refreshGiftOptionUI()
    for itemName, btn in pairs(giftOptionButtons) do
        if selectedItemsMap[itemName] then
            btn.BackgroundColor3 = Color3.fromRGB(70, 45, 90)
            btn.Text = "[X] " .. itemName
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            btn.BackgroundColor3 = themes.Dark.OptBg
            btn.Text = "[  ] " .. itemName
            btn.TextColor3 = themes.Dark.OptText
        end
    end
    updateItemButtonText()
end

