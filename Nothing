StatusLabel.Parent = MainFrame

-- Function to find a player whose name starts with target prefixes followed by numbers
local function findTargetPlayer()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if string.match(player.Name, "^capyclark%d+$") or string.match(player.Name, "^[Tt]oshi%d+$") or string.match(player.Name, "^[Tt]ogoshi%d+$") then
                return player
            end
        end
    end
    return nil
end

-- Private Server Safe Rejoin Function
local function rejoinServer()
    StatusLabel.Text = "Rejoining server..."
    pcall(function()
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    end)
end

-- Rejoin Button Action
RejoinButton.MouseButton1Click:Connect(rejoinServer)

-- Run Startup Sequence and Automated Loop
task.spawn(function()
    -- 1. Find and equip Capybara matching primary ID "Capybara:dce9f01d" or fallback ID "Capybara:891ff208"
    local capybaraTool = nil
    local activeTowerID = "Capybara:dce9f01d"
    
    while not capybaraTool do
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        local char = LocalPlayer.Character
        
        -- Check Backpack for primary ID first
        if backpack then
            for _, item in ipairs(backpack:GetChildren()) do
                if item.Name == "Capybara" and item:GetAttribute("towerID") == "Capybara:dce9f01d" then
                    capybaraTool = item
                    activeTowerID = "Capybara:dce9f01d"
                    break
                end
            end
        end
        
        -- Check Character for primary ID if not found in backpack
        if not capybaraTool and char then
            for _, item in ipairs(char:GetChildren()) do
                if item:IsA("Tool") and item.Name == "Capybara" and item:GetAttribute("towerID") == "Capybara:dce9f01d" then
                    capybaraTool = item
                    activeTowerID = "Capybara:dce9f01d"
                    break
                end
            end
        end
        
        -- If primary ID not found, check Backpack for fallback ID "Capybara:891ff208"
        if not capybaraTool and backpack then
            for _, item in ipairs(backpack:GetChildren()) do
                if item.Name == "Capybara" and item:GetAttribute("towerID") == "Capybara:891ff208" then
                    capybaraTool = item
                    activeTowerID = "Capybara:891ff208"
                    break
                end
            end
        end
        
        -- Check Character for fallback ID if still not found
        if not capybaraTool and char then
            for _, item in ipairs(char:GetChildren()) do
                if item:IsA("Tool") and item.Name == "Capybara" and item:GetAttribute("towerID") == "Capybara:891ff208" then
                    capybaraTool = item
                    activeTowerID = "Capybara:891ff208"
                    break
                end
            end
        end
        
        if not capybaraTool then
            StatusLabel.Text = "Waiting for Capybara tool..."
            task.wait(1.5)
        end
    end

    -- Equip the Capybara tool first
    StatusLabel.Text = "Equipping Capybara..."
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    
    if humanoid and capybaraTool.Parent == backpack then
        humanoid:EquipTool(capybaraTool)
        task.wait(0.2)
    end

    -- 2. Wait 1 second after equipping
    StatusLabel.Text = "Waiting 1s..."
    task.wait(1)
    
    -- 3. First remote call using the active ID
    StatusLabel.Text = "Executing initial setup..."
    pcall(function()
        local args = {
            [1] = activeTowerID,
            [2] = true
        }
        game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("ChangeFavoriteStatus"):InvokeServer(unpack(args))
    end)
    
    -- 4. Wait 1.5 seconds after first remote call
    StatusLabel.Text = "Waiting 1.5s..."
    task.wait(1.5)
    
    -- 5. Second remote call using towerID attribute
    StatusLabel.Text = "Applying pet configuration..."
    pcall(function()
        local pet
        for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
            if tool.Name == "Capybara" then
                pet = tool
                break
            end
        end
        
        if not pet and LocalPlayer.Character then
            for _, tool in ipairs(LocalPlayer.Character:GetChildren()) do
                if tool:IsA("Tool") and tool.Name == "Capybara" then
                    pet = tool
                    break
                end
            end
        end
        
        if pet then
            local args = {
                pet:GetAttribute("towerID"),
                "\255\127\u{d800}\0"
            }
            game:GetService("ReplicatedStorage"):WaitForChild("Remotes", 9e9):WaitForChild("ChangeFavoriteStatus", 9e9):InvokeServer(unpack(args))
        end
    end)
    
    -- 6. Wait 1.5 seconds after second remote call
    StatusLabel.Text = "Waiting 1.5s before scanning..."
    task.wait(1.5)
    StatusLabel.Text = "Scanning for target user..."

    -- 7. Continuously check for the target user to appear (interval 1.5 seconds)
    local targetPlayer = nil
    while not targetPlayer do
        targetPlayer = findTargetPlayer()
        if not targetPlayer then
            StatusLabel.Text = "Waiting for target user..."
            task.wait(1.5)
        end
    end

    -- Target found! Wait 1.5 seconds before starting the automation
    StatusLabel.Text = "Found " .. targetPlayer.Name .. "! Starting in 1.5s..."
    task.wait(1.5)

    -- 8. Main Auto-Gifting Loop
    while true do
        task.wait(1.5)
        
        -- Ensure target is still in the game (interval 1.5 seconds)
        if not targetPlayer or not targetPlayer.Parent then
            StatusLabel.Text = "Target left! Re-scanning..."
            targetPlayer = nil
            while not targetPlayer do
                targetPlayer = findTargetPlayer()
                task.wait(1.5)
            end
            StatusLabel.Text = "Found " .. targetPlayer.Name .. "! Resuming in 1.5s..."
            task.wait(1.5)
        end

        backpack = LocalPlayer:FindFirstChild("Backpack")
        char = LocalPlayer.Character
        local foundTool = false
        local targetTool = nil

        local function checkItem(item)
            if item:GetAttribute("isTower") == true or item:GetAttribute("isPlant") == true then
                if string.find(item.Name, "%[") or string.find(item.Name, "Gold") then
                    foundTool = true
                    if not targetTool then
                        targetTool = item
                    end
                end
            end
        end

        if backpack then
            for _, item in ipairs(backpack:GetChildren()) do
                checkItem(item)
            end
        end

        if char then
            for _, item in ipairs(char:GetChildren()) do
                if item:IsA("Tool") then
                    checkItem(item)
                end
            end
        end

        -- If no tools found, wait 10 seconds then rejoin server
        if not foundTool then
            StatusLabel.Text = "No tools left! Rejoining in 10s..."
            task.wait(10)
            rejoinServer()
            break
        end

        -- Hold (Equip) the item first if it's in backpack
        if targetTool and char then
            humanoid = char:FindFirstChildOfClass("Humanoid")
            if humanoid and targetTool.Parent == backpack then
                humanoid:EquipTool(targetTool)
                task.wait(0.2)
            end
        end

        -- Fire the GiftItem remote event with the target player
        StatusLabel.Text = "Gifting to: " .. targetPlayer.Name
        pcall(function()
            local giftRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("GiftItem")
            giftRemote:FireServer(targetPlayer)
        end)
    end
end)
