StatusLabel.Parent = MainFrame

local selectedPlayer = nil
local isRunning = false

-- Populate Player List
local function updatePlayerList()
    for _, child in ipairs(ScrollingFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 28)
            btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            btn.Text = player.Name
            btn.TextSize = 13
            btn.Font = Enum.Font.SourceSans
            btn.Parent = ScrollingFrame

            btn.MouseButton1Click:Connect(function()
                selectedPlayer = player
                StatusLabel.Text = "Target: " .. player.Name
                for _, b in ipairs(ScrollingFrame:GetChildren()) do
                    if b:IsA("TextButton") then
                        b.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
                    end
                end
                btn.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
            end)
        end
    end
    ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y)
end

Players.PlayerAdded:Connect(updatePlayerList)
Players.PlayerRemoving:Connect(updatePlayerList)
updatePlayerList()

-- Toggle Script Execution
StartButton.MouseButton1Click:Connect(function()
    if not selectedPlayer then
        StatusLabel.Text = "Please select a player first!"
        return
    end
    
    isRunning = not isRunning
    if isRunning then
        StartButton.Text = "Start: ON"
        StartButton.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
    else
        StartButton.Text = "Start: OFF"
        StartButton.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
    end
end)

-- Rejoin Button Action
RejoinButton.MouseButton1Click:Connect(function()
    StatusLabel.Text = "Rejoining server..."
    pcall(function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
    end)
end)

-- Main Loop with 1.5 Second Interval & Auto-Rejoin Check
task.spawn(function()
    while true do
        task.wait(1.5)
        if isRunning and selectedPlayer then
            -- 1. Check if matching tools still exist in Backpack or Character
            local backpack = LocalPlayer:FindFirstChild("Backpack")
            local char = LocalPlayer.Character
            local foundTool = false

            local function checkItem(item)
                if item:GetAttribute("isTower") == true then
                    if string.find(item.Name, "%[") or string.find(item.Name, "Gold") then
                        foundTool = true
                    end
                end
            end

            if backpack then
                for _, item in ipairs(backpack:GetChildren()) do
                    checkItem(item)
                end
            end

            if char then
                for _, item in ipairs(char:GetChildren()) do
                    if item:IsA("Tool") then
                        checkItem(item)
                    end
                end
            end

            -- If no tools found, automatically rejoin server
            if not foundTool then
                StatusLabel.Text = "No tools left! Rejoining..."
                task.wait(0.5)
                pcall(function()
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
                end)
                break
            end

            -- 2. Teleport to selected user's character
            local targetChar = selectedPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") and targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
                char.HumanoidRootPart.CFrame = targetChar.HumanoidRootPart.CFrame * CFrame.new(0, 3, 0)
            end

            -- 3. Equip valid inventory items
            if backpack and char then
                for _, item in ipairs(backpack:GetChildren()) do
                    if item:GetAttribute("isTower") == true then
                        if string.find(item.Name, "%[") or string.find(item.Name, "Gold") then
                            local humanoid = char:FindFirstChildOfClass("Humanoid")
                            if humanoid then
                                humanoid:EquipTool(item)
                            end
                        end
                    end
                end
            end

            -- 4. Spam ProximityPrompts near the target player
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("ProximityPrompt") then
                    local parentPart = obj.Parent
                    if parentPart and parentPart:IsA("BasePart") then
                        if targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
                            if (parentPart.Position - targetChar.HumanoidRootPart.Position).Magnitude < 15 then
                                pcall(function()
                                    fireproximityprompt(obj)
                                end)
                            end
                        end
                    end
                end
            end
        end
    end
end)