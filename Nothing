                            if nextRebirthData then
                                rebirthNumber = nextRebirthData.RebirthNumber
                                rebirthZone = nextRebirthData.ZoneNumberRequired
                            end
                        end
                    end)
                end
                teleportToMaxZone()
            end
        end
        
        task.wait(getgenv().autoWorldConfig.PURCHASE_CHECK_DELAY or 1)
    end
end)

