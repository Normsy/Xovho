-- Helper Loops & Utilities (Updated Auto Buy: 4 iterations, 5-minute cooldown)
--------------------------------------------------------------------------------
local activeBuyLoops = {}
local function startReliableBuyLoop(loopKey, getItemsFunc, buyRemoteFunc)
    if activeBuyLoops[loopKey] then return end
    activeBuyLoops[loopKey] = true
    task.spawn(function()
        while activeBuyLoops[loopKey] do
            -- Loop 4 times
            for i = 1, 4 do
                if not activeBuyLoops[loopKey] then break end
                local success, items = pcall(getItemsFunc)
                if success and items then
                    for _, item in ipairs(items) do
                        if not activeBuyLoops[loopKey] then break end
                        local bought = false
                        for _ = 1, 3 do
                            if not activeBuyLoops[loopKey] then break end
                            local buySuccess = pcall(function() buyRemoteFunc(item) end)
                            if buySuccess then bought = true; break end
                            task.wait(0.1)
                        end
                        task.wait(bought and 0.15 or 0.3)
                    end
                end
                task.wait(1)
            end
            
            -- Wait 5 minutes before buying again (300 seconds)
            local waitTime = 300
            while waitTime > 0 and activeBuyLoops[loopKey] do
                task.wait(1)
                waitTime = waitTime - 1
            end
        end
    end)
end

local function stopReliableBuyLoop(loopKey)
    activeBuyLoops[loopKey] = false
end

local function equipSpecificScrapTool(toolName)
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack or not humanoid then return false end
    for _, item in ipairs(backpack:GetChildren()) do
        if item:IsA("Tool") and not item.Name:lower():find("egg") then
            if item.Name:find(toolName) then
                humanoid:EquipTool(item)
                return true
            end
        end
    end
    return false
end

