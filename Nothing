task.spawn(function()
    print("Starting zone purchase service")
    while unfinished do
        if not getgenv().ScriptEnabled then
            task.wait(1)
            continue
        end
        
        local successTrain, nextZoneName, nextZoneData = pcall(function()
            return require(game:GetService("ReplicatedStorage").Library.Client.ZoneCmds).GetNextZone()
        end)
        
        if successTrain and nextZoneName then
            local success, err = pcall(function()
                return game:GetService("ReplicatedStorage").Network.Zones_RequestPurchase:InvokeServer(nextZoneName)
            end)
            if success and err then
                print("Successfully purchased " .. tostring(nextZoneName))
                if getgenv().autoWorldConfig.AUTO_REBIRTH then
                    pcall(function()
                        if nextZoneData and nextZoneData.ZoneNumber >= rebirthZone then
                            print("Rebirthing")
                            game:GetService("ReplicatedStorage").Network.Rebirth_Request:InvokeServer(tostring(rebirthNumber))
                            task.wait(15)
